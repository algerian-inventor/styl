# STLY Constantine Environment Variables Template
# Copy this file to .env.local and fill in the values. Do not commit actual secrets to Git.

# 1. Database Connection
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/stly_constantine?schema=public"

# 2. Authentication Secrets
# You can generate a random secret using: openssl rand -base64 32
AUTH_SECRET="your_next_auth_secret_placeholder"

# 3. Public/Private API Base URL
NEXT_PUBLIC_API_URL="http://localhost:3000"
