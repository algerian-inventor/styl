# STLY Constantine - Supabase Production Environment Variables Template
# Copy this file to .env.local and populate with your Supabase project credentials.

# Public Supabase API configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side administration key (NEVER expose to client components or push to Git)
SUPABASE_SERVICE_ROLE_KEY=
